{
  "applicationId": "js.neutralino.zero",
  "version": "1.0.0",
  "defaultMode": "window",
  "documentRoot": "/client/dist/",
  "url": "/",
  "enableServer": true,
  "enableNativeAPI": true,
  "nativeAllowList": [
    "app.*",
    "filesystem.readDirectory"
  ],
  "modes": {
    "window": {
      "title": "local-ai-client",
      "width": 800,
      "height": 500,
      "minWidth": 400,
      "minHeight": 200,
      "icon": "/client/public/icon.svg"
    }
  },
  "cli": {
    "binaryName": "local-ai-client",
    "resourcesPath": "/client/dist/",
    "extensionsPath": "/extensions/",
    "binaryVersion": "6.9.0",
    "clientVersion": "6.9.0"
  }
}