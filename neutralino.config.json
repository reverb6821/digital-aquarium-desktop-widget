{
  "applicationId": "com.ai.client",
  "version": "1.0.0",
  "defaultMode": "window",
  "documentRoot": "/client/dist/",
  "url": "/",
  "enableServer": true,
  "enableNativeAPI": true,
  "nativeAllowList": [
    "app.*",
    "filesystem.readDirectory",
    "os.*",
    "computer.*",
    "debug.log",
    "events.*",
    "storage.*"
  ],
  "modes": {
    "window": {
      "title": "local-ai-client",
      "width": 900,
      "height": 720,
      "minWidth": 420,
      "minHeight": 400,
      "icon": "/client/public/icon.svg",
      "resizable": true,
      "exitProcessOnClose": true
    }
  },
  "cli": {
    "binaryName": "local-ai-client",
    "resourcesPath": "/client/dist/",
    "extensionsPath": "/extensions/",
    "binaryVersion": "6.9.0",
    "clientVersion": "6.9.0"
  }
}